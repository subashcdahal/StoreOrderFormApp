# Copy to .env and fill in.  Everything here can also be set in the app's
# Settings panel, which is stored in the database and wins over these values.

PORT=3000

# ---- Store identity ------------------------------------------------------
STORE_NAME=Your Grocery Store
REPLY_TO=orders@yourstore.com

# ---- Outgoing mail (SMTP) ------------------------------------------------
# Gmail: use an App Password (Google Account > Security > 2-Step Verification
# > App passwords). Your normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Your Grocery Store <you@gmail.com>

# ---- Sign-in -------------------------------------------------------------
# Public address of the app, used to build password-reset links. Leave blank to
# use whatever address the browser used to reach it.
APP_URL=https://inventory.yourstore.com

# Only used the very first time the app starts on an empty database. After that
# the account lives in SQLite and these are ignored — change the password in
# Settings > Account, not here.
DEFAULT_USERNAME=himalayanbazaar
DEFAULT_PASSWORD=5103Magna
# Email that password-reset links go to (also editable in Settings > Account)
DEFAULT_EMAIL=

# ---- Paths (leave alone when using Docker) -------------------------------
# ORDER_FORMS_DIR=/app/Order Forms
# DATA_DIR=/app/data

# Set to 0 to skip the automatic first import on a fresh database
AUTO_INGEST=1
